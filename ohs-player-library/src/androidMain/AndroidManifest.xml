<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for FHIR sync and the OIDC auth flow (discovery, token exchange, userinfo). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".OhsPlayerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Captures the OAuth redirect. The scheme/host are injected as manifest
          placeholders (oauthRedirectScheme / oauthRedirectHost) by the consuming
          app module, which resolves them from OAUTH_REDIRECT_SCHEME /
          OAUTH_REDIRECT_HOST (env var, then local.properties, then default).
        -->
        <activity
            android:name=".auth.LoginRedirectActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${oauthRedirectScheme}"
                    android:host="${oauthRedirectHost}" />
            </intent-filter>
        </activity>
    </application>

</manifest>